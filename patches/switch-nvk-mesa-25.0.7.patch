+   uint32_t extracted = 0;
+   for (uint16_t bit = start; bit < end; bit++) {
+      const uint32_t set = (qmd[bit / 32] >> (bit % 32)) & 1;
+      extracted |= set << (bit - start);
+   }
+   *value = extracted;
+   return true;
