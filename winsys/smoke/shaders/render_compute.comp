#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D image_a;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D image_b;
layout(push_constant) uniform Seed { uint value; } seed;

void main()
{
   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
   vec4 s = texelFetch(image_a, p, 0);
   uvec4 b = uvec4(round(s * 255.0));
   uvec4 out_b = uvec4(b.b ^ seed.value, 255u - b.g,
                        b.r + seed.value * 9u, b.a ^ (seed.value & 15u));
   imageStore(image_b, p, vec4(out_b & 255u) / 255.0);
}
