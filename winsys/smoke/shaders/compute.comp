#version 450

// FG-1 deterministic path: one invocation handles one buffer element and one
// pixel.  The source image is sampled with nearest filtering and its red/blue
// channels are swapped before the result is written to the storage image.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputValues {
   uint values[];
} input_values;

layout(set = 0, binding = 1, std430) writeonly buffer OutputValues {
   uint values[];
} output_values;

layout(set = 0, binding = 2) uniform sampler2D source_image;
layout(set = 0, binding = 3, rgba8) writeonly uniform image2D destination_image;

void main()
{
   uint index = gl_GlobalInvocationID.x;
   if (index >= 64u)
      return;

   output_values.values[index] = (input_values.values[index] ^ 0xa5a5a5a5u) + index;

   ivec2 pixel = ivec2(index & 7u, index >> 3u);
   vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(8.0);
   vec4 source = texture(source_image, uv);
   imageStore(destination_image, pixel, source.bgra);
}
